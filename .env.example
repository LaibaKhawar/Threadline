# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

POSTGRES_USER=threadline
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=threadline

COOKIE_SECURE=false            # true behind HTTPS (required in production)
CORS_ORIGINS=http://localhost:3000
ALLOW_REGISTRATION=true
AUTH_RATE_LIMIT_PER_MINUTE=10   # raise only for automated E2E runs
DEMO_LOGIN_ENABLED=true        # one-click demo sign-in (synthetic data only). Set false for any deployment holding real data.
LOCAL_IMPORT_ROOTS=            # comma-separated folders the local-folder connector may read; empty = folder import disabled
                               # (in Docker, mount the folder into the backend and worker containers and list the mount path)

# AI. LOCAL is the default and makes zero cloud calls.
DEFAULT_AI_MODE=LOCAL
OLLAMA_BASE_URL=http://localhost:11434
REASONING_MODEL=qwen3:4b-instruct-2507-q4_K_M
EXTRACTION_MODEL=qwen3:4b-instruct-2507-q4_K_M
EMBEDDING_PROVIDER=fastembed   # fastembed | ollama | hashing
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional OpenAI-compatible cloud provider (only used in HYBRID/CLOUD mode and only for sources you allow).
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=
CLOUD_INPUT_COST_PER_MTOK=0
CLOUD_OUTPUT_COST_PER_MTOK=0

# Optional Google OAuth (Gmail + Calendar, read-only scopes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/google/callback

TELEMETRY_ENABLED=false        # Threadline sends no telemetry; this flag is reserved and does nothing when false
